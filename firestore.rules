rules_version = '2';
// The app stores all data in MongoDB and does not use Firestore.
// Deny every client read/write so a stale rule set cannot be abused
// (previously any signed-in user could create orders and set their own role).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
